# GitHub — create at github.com/settings/tokens (scopes: public_repo, read:user)
GITHUB_TOKEN=your_github_pat_here

# Anthropic — Salesforce Bedrock proxy
ANTHROPIC_API_KEY=your_anthropic_key_here
ANTHROPIC_BASE_URL=https://eng-ai-model-gateway.sfproxy.devx-preprod.aws-esvc1-useast2.aws.sfdc.cl/bedrock
AI_MODEL=claude-sonnet-4-6

# FalkorDB (use localhost when running outside Docker, falkordb when inside Docker)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379

# GitHub OAuth App (create at github.com/settings/developers → OAuth Apps)
# Callback URL to set: http://localhost:8000/api/auth/github/callback
GITHUB_CLIENT_ID=your_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_oauth_app_client_secret

# App
GITHUB_USERNAME=PRABHU-OFFICIAL-II
FRONTEND_URL=http://localhost:5173
